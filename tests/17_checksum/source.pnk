// A Fletcher-style checksum, streamed one byte per FFI call.
fun 1 main() {
  var 1 s1 = 0;
  var 1 s2 = 0;
  var 1 i = 0;
  while i < 24 {
    @read(0, 0, @base, 1);
    s1 = (s1 + (ld8 @base)) & 255;
    s2 = (s2 + s1) & 255;
    i = i + 1;
  }
  st8 @base, s1;
  st8 @base + 1, s2;
  @write(0, 0, @base, 2);
  return 0;
}
