// Sum the odd inputs among 32 bytes, stopping at the first zero byte.
fun 1 main() {
  @read(0, 0, @base, 32);
  var 1 i = 0;
  var 1 acc = 0;
  while i < 32 {
    var 1 x = ld8 (@base + i);
    i = i + 1;
    if x == 0 { break; }
    if (x & 1) == 0 { continue; }
    acc = acc + x;
  }
  st @base, acc;
  @write(0, 0, @base, 8);
  return 0;
}
