// A multiplication table modulo 256.
fun 1 main() {
  @read(0, 0, @base, 1);
  var 1 n = ((ld8 @base) & 7) + 1;
  var 1 i = 0;
  while i < n {
    var 1 j = 0;
    while j < n {
      st8 @base + 8 + i * 8 + j, i * j + n;
      j = j + 1;
    }
    i = i + 1;
  }
  @write(0, 0, @base + 8, 64);
  return 0;
}
